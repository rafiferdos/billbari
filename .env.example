# BillBari (বিলবাড়ি) Environment Variables

# Server Configuration
PORT=3000
NODE_ENV=development

# Persistent Database (SQLite)
# Default is ./data/billbari.db
DATABASE_PATH=./data/billbari.db

# Authentication
# Secret used for session security
SESSION_SECRET=billbari_super_secure_random_secret_key_bangladesh_2026

# Google OAuth (Optional - development includes built-in one-click Google demo authentication)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# NESCO Customer Service Portal
NESCO_PORTAL_URL=https://customer.nesco.gov.bd/pre/panel
