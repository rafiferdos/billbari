# ==========================================
# বিলবাড়ি (BillBari) Environment Variables
# ==========================================

# সার্ভার কনফিগারেশন
PORT=3000
NODE_ENV=development

# ------------------------------------------
# ১. বিকাশ পেমেন্ট (bKash Send Money)
# ------------------------------------------
# আপনার যে বিকাশ পার্সোনাল নম্বরে গ্রাহকরা সেন্ড মানি (২০ বা ১০০ টাকা) করবেন:
BKASH_PERSONAL_NUMBER=017XXXXXXXX

# ------------------------------------------
# ২. ক্লাউড ডাটাবেস (Turso / libSQL)
# ------------------------------------------
# Vercel বা প্রোডাকশনে পারসিস্টেন্ট ডাটাবেসের জন্য Turso ব্যবহার আবশ্যক (ফ্রি ৯ জিবি):
# https://turso.tech থেকে ডাটাবেস খুলে URL এবং Token দিন
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# লোকাল ডেভেলপমেন্টের জন্য লোকাল SQLite ফাইল (Turso না দিলে এটি কাজ করবে):
DATABASE_PATH=./data/billbari.db

# ------------------------------------------
# ৩. সেশন সিকিউরিটি
# ------------------------------------------
SESSION_SECRET=billbari_super_secure_random_secret_key_bangladesh_2026

# ------------------------------------------
# ৪. গুগল ওথ (Google OAuth Login)
# ------------------------------------------
# Google Cloud Console (APIs & Services > Credentials) থেকে সংগৃহীত:
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# লোকাল ডেভেলপমেন্টে:
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
# Vercel বা প্রোডাকশনে:
# GOOGLE_REDIRECT_URI=https://your-domain.vercel.app/api/auth/callback/google

# ------------------------------------------
# ৫. নেসকো সরকারি পোর্টাল ও প্রক্সি
# ------------------------------------------
NESCO_PORTAL_URL=https://customer.nesco.gov.bd/pre/panel

# (ঐচ্ছিক) যদি Vercel/সার্ভার দেশের বাইরে (US/EU) হোস্টেড থাকায় নেসকো পোর্টাল 403 Forbidden দেয়,
# তবে বিডি ভিত্তিক প্রক্সি বা ব্রিজ ইউআরএল এখানে দিন:
# NESCO_PROXY_URL=https://your-bd-bridge.example.com
